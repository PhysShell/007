#!/usr/bin/env bash
# o7-secret — a tiny reference-not-value secret store (age-encrypted at rest).
# The whole point: scripts REFERENCE a secret by NAME; the value is decrypted
# only into a subprocess env (never printed, never in your shell history, never
# in a chat). This is the local, transparent twin of `bw get` / `op run`.
#
#   o7-secret init                 # create the age identity (your local unlock key)
#   o7-secret set  NAME            # read a value from your TTY (silent) -> encrypt
#   o7-secret set  NAME --stdin    # read the value from stdin (for pipes/scripts)
#   o7-secret get  NAME            # decrypt to stdout  (prints the value — use sparingly)
#   o7-secret run  NAME[,NAME2] -- cmd args...   # inject as env VARS into cmd, never printed
#   o7-secret ls                   # list secret NAMES (never values)
#   o7-secret rm   NAME
#
# Store:    $O7_SECRET_HOME     (default ~/.local/share/o7-research/secrets)  -> NAME.age
# Identity: $O7_SECRET_IDENTITY (default ~/.config/o7-research/age-identity.txt, 0600)
# Needs `age`/`age-keygen` on PATH (e.g. `nix shell nixpkgs#age`).
set -euo pipefail
HOME_DIR="${O7_SECRET_HOME:-$HOME/.local/share/o7-research/secrets}"
IDENT="${O7_SECRET_IDENTITY:-$HOME/.config/o7-research/age-identity.txt}"
die(){ echo "o7-secret: $*" >&2; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "missing '$1' on PATH (try: nix shell nixpkgs#age)"; }
_recipient(){ age-keygen -y "$IDENT" 2>/dev/null; }
_ok_name(){ [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "bad secret name '$1' (use env-var-safe chars)"; }

cmd_init(){
  need age-keygen
  if [ -f "$IDENT" ]; then echo "identity already exists: $IDENT"; return 0; fi
  mkdir -p "$(dirname "$IDENT")"; ( umask 077; age-keygen -o "$IDENT" 2>/dev/null ); chmod 600 "$IDENT"
  mkdir -p "$HOME_DIR"; chmod 700 "$HOME_DIR"
  echo "created identity: $IDENT (KEEP IT — losing it makes every secret unrecoverable)"
  echo "public recipient: $(_recipient)"
}
_require_ident(){ [ -f "$IDENT" ] || die "no identity yet — run: o7-secret init"; }
cmd_set(){
  need age; _require_ident; _ok_name "${1:-}"; local name="$1"; shift || true
  mkdir -p "$HOME_DIR"
  local val
  if [ "${1:-}" = "--stdin" ]; then IFS= read -r val || true
  else read -rs -p "value for '$name' (input hidden): " val; echo >&2; fi
  [ -n "$val" ] || die "empty value refused"
  printf '%s' "$val" | age -r "$(_recipient)" -o "$HOME_DIR/$name.age"
  chmod 600 "$HOME_DIR/$name.age"; unset val
  echo "stored: $name  (encrypted -> $HOME_DIR/$name.age)"
}
cmd_get(){ need age; _require_ident; _ok_name "${1:-}"; local f="$HOME_DIR/$1.age"; [ -f "$f" ] || die "no such secret: $1"; age -d -i "$IDENT" "$f"; }
cmd_run(){
  need age; _require_ident
  local names="${1:-}"; [ -n "$names" ] || die "run needs NAME[,NAME2] -- cmd"; shift
  [ "${1:-}" = "--" ] || die "expected -- before the command"; shift
  [ $# -ge 1 ] || die "run needs a command after --"
  local env_args=() n f v
  IFS=',' read -ra arr <<< "$names"
  for n in "${arr[@]}"; do _ok_name "$n"; f="$HOME_DIR/$n.age"; [ -f "$f" ] || die "no such secret: $n"
    v="$(age -d -i "$IDENT" "$f")"; env_args+=("$n=$v"); unset v; done
  exec env "${env_args[@]}" "$@"     # secrets exist only in this child's env; never printed
}
cmd_ls(){ [ -d "$HOME_DIR" ] || { echo "(empty)"; return 0; }; find "$HOME_DIR" -maxdepth 1 -name '*.age' -printf '%f\n' 2>/dev/null | sed 's/\.age$//' | sort; }
cmd_rm(){ _ok_name "${1:-}"; rm -f "$HOME_DIR/$1.age" && echo "removed: $1"; }
[ $# -ge 1 ] || die "usage: init|set|get|run|ls|rm  (see header)"
sub="$1"; shift
case "$sub" in init)cmd_init "$@";; set)cmd_set "$@";; get)cmd_get "$@";; run)cmd_run "$@";; ls)cmd_ls "$@";; rm)cmd_rm "$@";; *)die "unknown: $sub";; esac
