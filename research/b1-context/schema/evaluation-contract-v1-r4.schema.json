        "artifact_bytes_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_length": {
          "$ref": "#/$defs/nonneg"
        },
        "record_count": {
          "$ref": "#/$defs/nonneg"
        },
        "session_id": {
          "minLength": 1,
          "type": "string"
        },
        "visibility": {
          "const": "private"
        }
      },
      "required": [
        "session_id",
        "visibility",
        "artifact_bytes_sha256",
        "byte_length",
        "record_count"
      ],
      "type": "object"
    },
    "projection_only_family": {
      "additionalProperties": false,
      "properties": {
        "full_derived": {
          "const": "NOT_APPLICABLE"
        },
        "negative_control": {
          "const": "NOT_APPLICABLE"
        },
