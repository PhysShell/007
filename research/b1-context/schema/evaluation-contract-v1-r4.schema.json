{
  "$defs": {
    "dual_id": {
      "additionalProperties": false,
      "properties": {
        "artifact_bytes_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_length": {
          "$ref": "#/$defs/nonneg"
        },
        "canonical_object_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "logical_id": {
          "type": "string"
        }
      },
      "required": [
        "logical_id",
        "artifact_bytes_sha256",
        "canonical_object_sha256",
        "byte_length"
      ],
      "type": "object"
    },
    "gate_id": {
      "pattern": "^gate-(0[1-9]|1[01])$",
      "type": "string"
    },
    "gitsha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "nonneg": {
      "minimum": 0,
      "type": "integer"
    },
    "obsid": {
