          "artifact_bytes_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "byte_length": {
            "$ref": "#/$defs/nonneg"
          },
          "canonical_object_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "visibility": {
            "const": "public"
          }
        },
        "required": [
          "visibility",
          "artifact_bytes_sha256",
          "canonical_object_sha256",
          "byte_length"
        ],
        "type": "object"
      },
      "description": "Logical id is the mapping KEY (not a field). Each value is a public structured input carrying both digest domains and byte length.",
      "minProperties": 1,
      "type": "object"
    },
    "public_structured_named": {
      "additionalProperties": false,
      "properties": {
        "artifact_bytes_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_length": {
          "$ref": "#/$defs/nonneg"
        },
        "canonical_object_sha256": {
