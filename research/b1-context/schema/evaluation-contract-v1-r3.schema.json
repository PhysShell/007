{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physshell.dev/007/research/b1-context/schema/evaluation-contract-v1-r3.schema.json",
  "title": "o7.b1.evaluation-contract/v1 (revision 3, schema-validation closure)",
  "description": "Fail-closed schema for contract revision 3. VALIDATION revision only: no normative semantic value from revision 2 is changed; several fields are mechanically restructured so the schema enforces the frozen prose (R4A.2). Closes: unconstrained bound_inputs, unconstrained family_applicability, arbitrary consistency-gate text, prose full_derived requirements, pair_expectations without explicit endpoints, and a repeatable output_must_record. history_rationale is non-normative and removed from the instance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "contract_revision", "semantic_revision_from_r2", "validation_revision", "supersedes_contract_revision", "supersedes", "provenance_role", "digest_domains", "arms", "arm_semantics", "family_applicability", "full_derived_semantics", "source_compilation_requirements_full_derived", "budget", "input_closure", "bound_inputs", "tasks", "contract_input_consistency_gates", "task_dependence", "shape_semantics", "evaluator_implementation_identity", "outcome_axes", "axis_requirements", "overall_rules"],
  "properties": {
    "schema": {"const": "o7.b1.evaluation-contract/v1"},
    "contract_id": {"const": "o7.b1.evaluation-contract/v1"},
    "contract_revision": {"const": 3},
    "semantic_revision_from_r2": {"const": false},
    "validation_revision": {"const": true},
    "supersedes_contract_revision": {"const": 2},
    "supersedes": {"type": "object", "additionalProperties": false,
      "required": ["instance", "artifact_bytes_sha256", "r4a1_contract_commit"],
      "properties": {"instance": {"const": "evaluation-contract-v1-r2.yaml"}, "artifact_bytes_sha256": {"$ref": "#/$defs/sha256"}, "r4a1_contract_commit": {"$ref": "#/$defs/gitsha"}}},
    "provenance_role": {"type": "object", "additionalProperties": false,
      "required": ["case_role", "designed_after_observing_case_0002", "holdout_evidence", "generalization_claim_allowed"],
      "properties": {"case_role": {"const": "development"}, "designed_after_observing_case_0002": {"const": true},
        "holdout_evidence": {"const": false}, "generalization_claim_allowed": {"const": false}}},
    "digest_domains": {"type": "object", "additionalProperties": false,
      "required": ["canonicalization", "policy", "gold_state_dual_binding"],
      "properties": {"canonicalization": {"type": "object", "additionalProperties": false, "required": ["id", "definition"],
          "properties": {"id": {"const": "o7-canonical-json-v0"}, "definition": {"type": "string"}}},
        "policy": {"type": "string"}, "gold_state_dual_binding": {"$ref": "#/$defs/dual_id"}}},
    "arms": {"type": "object", "additionalProperties": false, "required": ["full_derived", "projection", "negative_control"],
      "properties": {"full_derived": {"$ref": "#/$defs/required_arm"}, "projection": {"$ref": "#/$defs/required_arm"},
        "negative_control": {"type": "object", "additionalProperties": false, "required": ["requirement"], "properties": {"requirement": {"const": "optional"}}}}},
    "arm_semantics": {"type": "object", "additionalProperties": false,
      "required": ["missing_required_arm", "missing_optional_arm", "non_applicable_metrics", "synthetic_negative_control", "gold_state"],
      "properties": {"missing_required_arm": {"const": "UNAVAILABLE"}, "missing_optional_arm": {"const": "NOT_APPLICABLE"},
        "non_applicable_metrics": {"type": "null"}, "synthetic_negative_control": {"const": "forbidden"}, "gold_state": {"type": "string"}}},
    "family_applicability": {"type": "object", "additionalProperties": false,
      "required": ["source_compilation", "projection_validity", "question_observation_support", "relation_support", "stale_state_safety", "negative_control_diagnostics"],
      "properties": {
        "source_compilation": {"type": "object", "additionalProperties": false, "required": ["full_derived", "projection", "negative_control"],
          "properties": {"full_derived": {"const": "required"}, "projection": {"const": "required"}, "negative_control": {"const": "optional"}}},
        "projection_validity": {"$ref": "#/$defs/projection_only_family"},
        "question_observation_support": {"$ref": "#/$defs/projection_only_family"},
        "relation_support": {"$ref": "#/$defs/projection_only_family"},
        "stale_state_safety": {"$ref": "#/$defs/projection_only_family"},
        "negative_control_diagnostics": {"type": "object", "additionalProperties": false, "required": ["negative_control"],
          "properties": {"negative_control": {"const": "optional"}}}}},
    "full_derived_semantics": {"type": "string"},
    "source_compilation_requirements_full_derived": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": {"enum": ["session_matches_derived_manifest", "derived_body_available", "derived_byte_length_and_sha256_match", "record_count_reproducible", "extractor_identity_and_raw_binding_present"]}},
    "source_compilation_note": {"type": "string"},
    "budget": {"type": "object", "additionalProperties": false,
      "required": ["authoritative_artifact", "artifact_bytes_sha256", "canonical_object_sha256", "byte_length", "byte_budget", "record_budget", "unit", "counted_representation", "diagnostics"],
      "properties": {"authoritative_artifact": {"const": "budget-v0.yaml"}, "artifact_bytes_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_object_sha256": {"$ref": "#/$defs/sha256"}, "byte_length": {"$ref": "#/$defs/nonneg"},
        "byte_budget": {"const": 20000}, "record_budget": {"const": 32}, "unit": {"const": "utf8_bytes+records"},
        "counted_representation": {"type": "object", "additionalProperties": false, "required": ["id", "definition", "gating"],
          "properties": {"id": {"const": "selector-v0-canonical-record-jsonl"}, "definition": {"type": "string"}, "gating": {"const": true}}},
        "diagnostics": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false,
          "required": ["gating"], "properties": {"gating": {"const": false}}}}}},
    "input_closure": {"type": "object", "additionalProperties": false,
      "required": ["required_public_structured", "required_private", "negative_control_body", "raw_source_bodies", "fail_closed"],
      "properties": {"required_public_structured": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "required_private": {"type": "array", "items": {"type": "string"}}, "negative_control_body": {"type": "string"},
        "raw_source_bodies": {"type": "string"}, "fail_closed": {"type": "string"}}},
    "bound_inputs": {"type": "object", "additionalProperties": false,
      "required": ["gold_state", "fixture_manifest", "source_selectors", "task_registry", "budget", "r3_1_report", "r3_1_projection_comparison", "r3_1_derived_manifest", "task_files", "question_files", "task_contexts", "derived_bodies_private"],
      "properties": {
        "gold_state": {"$ref": "#/$defs/public_structured_named"},
        "fixture_manifest": {"$ref": "#/$defs/public_structured_named"},
        "source_selectors": {"$ref": "#/$defs/public_structured_named"},
        "task_registry": {"$ref": "#/$defs/public_structured_named"},
        "budget": {"$ref": "#/$defs/public_structured_named"},
        "r3_1_report": {"$ref": "#/$defs/public_structured_named"},
        "r3_1_projection_comparison": {"$ref": "#/$defs/public_structured_named"},
        "r3_1_derived_manifest": {"$ref": "#/$defs/public_structured_named"},
        "task_files": {"$ref": "#/$defs/public_structured_keyed_map"},
        "question_files": {"$ref": "#/$defs/public_structured_keyed_map"},
        "task_contexts": {"$ref": "#/$defs/public_structured_keyed_map"},
        "derived_bodies_private": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/private_body"}}}},
    "tasks": {"type": "object", "minProperties": 1,
      "additionalProperties": {"type": "object", "additionalProperties": false,
        "required": ["questions_file"],
        "properties": {"questions_file": {"type": "string"},
          "relation_requirements": {"type": "array", "items": {"$ref": "#/$defs/relation_requirement"}},
          "forbidden_stale_as_current": {"type": "array", "items": {"type": "object", "additionalProperties": false,
            "required": ["question", "ids"], "properties": {"question": {"type": "string"}, "ids": {"type": "array", "items": {"$ref": "#/$defs/obsid"}}}}}}}},
    "contract_input_consistency_gates": {
      "type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true,
      "description": "Exactly the eleven declared gate IDs, each present once, with a description. Set-completeness is enforced by the eleven contains clauses below; each gate's SEMANTIC recomputation is an evaluator consistency check at R4B.",
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "description"],
        "properties": {"id": {"$ref": "#/$defs/gate_id"}, "description": {"type": "string", "minLength": 1}}},
      "allOf": [
        {"contains": {"properties": {"id": {"const": "gate-01"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "gate-02"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "gate-03"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "gate-04"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "gate-05"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "gate-06"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "gate-07"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "gate-08"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "gate-09"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "gate-10"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "gate-11"}}, "required": ["id"]}}
      ]},
    "task_dependence": {"type": "object", "additionalProperties": false,
      "required": ["all_unordered_pairs", "pair_expectations", "not_frozen"],
      "properties": {"all_unordered_pairs": {"const": true},
        "pair_expectations": {"type": "array", "minItems": 1, "uniqueItems": true,
          "description": "One entry per unordered task pair, each carrying its explicit left and right task IDs. Endpoint distinctness (left != right) and pair completeness (all N-choose-2) are evaluator consistency checks — not expressible as a value comparison in JSON Schema draft 2020-12; the restructuring to an explicit list removes the string-key/endpoint disagreement class by construction.",
          "items": {"type": "object", "additionalProperties": false,
            "required": ["left", "right", "expected_shape"],
            "properties": {"left": {"type": "string", "minLength": 1}, "right": {"type": "string", "minLength": 1},
              "expected_shape": {"$ref": "#/$defs/pair_shape"}, "rationale": {"type": "string"}}}},
        "not_frozen": {"type": "string"}}},
    "shape_semantics": {"type": "object", "additionalProperties": false,
      "required": ["incomparable", "left_strict_superset", "unknown_shape"],
      "properties": {"incomparable": {"type": "string"}, "left_strict_superset": {"type": "string"}, "unknown_shape": {"const": "fail closed"}}},
    "evaluator_implementation_identity": {"type": "object", "additionalProperties": false,
      "required": ["manifest_schema", "manifest_digest_field", "output_must_record"],
      "properties": {"manifest_schema": {"const": "o7.b1.evaluator-implementation-manifest/v0"},
        "manifest_digest_field": {"type": "string"},
        "output_must_record": {"type": "object", "additionalProperties": false,
          "required": ["evaluator_entrypoint_sha256", "evaluator_module_sha256", "execution_checkout_commit", "execution_checkout_tree"],
          "properties": {"evaluator_entrypoint_sha256": {"const": "required"}, "evaluator_module_sha256": {"const": "required"},
            "execution_checkout_commit": {"const": "required"}, "execution_checkout_tree": {"const": "required"}}},
        "note": {"type": "string"}}},
    "outcome_axes": {"type": "array", "minItems": 8, "uniqueItems": true,
      "items": {"enum": ["contract_input_consistency", "source_compilation", "projection_validity", "question_observation_support", "relation_support", "stale_state_safety", "task_dependence", "negative_control_diagnostics"]}},
    "axis_requirements": {"type": "object", "additionalProperties": false,
      "required": ["contract_input_consistency", "source_compilation", "projection_validity", "question_observation_support", "relation_support", "stale_state_safety", "task_dependence", "negative_control_diagnostics"],
      "properties": {
        "contract_input_consistency": {"const": "required"}, "source_compilation": {"const": "required"},
        "projection_validity": {"const": "required"}, "question_observation_support": {"const": "required"},
        "relation_support": {"const": "required"}, "stale_state_safety": {"const": "required"},
        "task_dependence": {"const": "required"}, "negative_control_diagnostics": {"const": "optional"}}},
    "overall_rules": {"type": "object", "additionalProperties": false,
      "required": ["any_required_axis_FAIL", "any_required_axis_UNAVAILABLE_without_FAIL", "all_required_axes_PASS", "optional_diagnostics_cannot_upgrade_or_downgrade_required_gates", "PARTIAL"],
      "properties": {"any_required_axis_FAIL": {"const": "overall FAIL"},
        "any_required_axis_UNAVAILABLE_without_FAIL": {"const": "overall UNAVAILABLE"},
        "all_required_axes_PASS": {"type": "string"},
        "optional_diagnostics_cannot_upgrade_or_downgrade_required_gates": {"const": true},
        "PARTIAL": {"const": "forbidden in evaluation v1"}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nonneg": {"type": "integer", "minimum": 0},
    "obsid": {"type": "string", "pattern": "^obs-[a-z0-9-]+$"},
    "gate_id": {"type": "string", "pattern": "^gate-(0[1-9]|1[01])$"},
    "pair_shape": {"enum": ["incomparable", "left_strict_superset"]},
    "required_arm": {"type": "object", "additionalProperties": false, "required": ["requirement"], "properties": {"requirement": {"const": "required"}}},
    "projection_only_family": {"type": "object", "additionalProperties": false, "required": ["projection", "full_derived", "negative_control"],
      "properties": {"projection": {"const": "required"}, "full_derived": {"const": "NOT_APPLICABLE"}, "negative_control": {"const": "NOT_APPLICABLE"}}},
    "dual_id": {"type": "object", "additionalProperties": false, "required": ["logical_id", "artifact_bytes_sha256", "canonical_object_sha256", "byte_length"],
      "properties": {"logical_id": {"type": "string"}, "artifact_bytes_sha256": {"$ref": "#/$defs/sha256"}, "canonical_object_sha256": {"$ref": "#/$defs/sha256"}, "byte_length": {"$ref": "#/$defs/nonneg"}}},
    "public_structured_named": {"type": "object", "additionalProperties": false,
      "required": ["logical_id", "visibility", "artifact_bytes_sha256", "canonical_object_sha256", "byte_length"],
      "properties": {"logical_id": {"type": "string", "minLength": 1}, "visibility": {"const": "public"},
        "artifact_bytes_sha256": {"$ref": "#/$defs/sha256"}, "canonical_object_sha256": {"$ref": "#/$defs/sha256"}, "byte_length": {"$ref": "#/$defs/nonneg"}}},
    "public_structured_keyed_map": {"type": "object", "minProperties": 1,
      "description": "Logical id is the mapping KEY (not a field). Each value is a public structured input carrying both digest domains and byte length.",
      "additionalProperties": {"type": "object", "additionalProperties": false,
        "required": ["visibility", "artifact_bytes_sha256", "canonical_object_sha256", "byte_length"],
        "properties": {"visibility": {"const": "public"}, "artifact_bytes_sha256": {"$ref": "#/$defs/sha256"},
          "canonical_object_sha256": {"$ref": "#/$defs/sha256"}, "byte_length": {"$ref": "#/$defs/nonneg"}}}},
    "private_body": {"type": "object", "additionalProperties": false,
      "required": ["session_id", "visibility", "artifact_bytes_sha256", "byte_length", "record_count"],
      "description": "Private derived body: artifact-bytes digest ONLY (bodies carry no canonical-object digest). session_id uniqueness is an evaluator consistency check.",
      "properties": {"session_id": {"type": "string", "minLength": 1}, "visibility": {"const": "private"},
        "artifact_bytes_sha256": {"$ref": "#/$defs/sha256"}, "byte_length": {"$ref": "#/$defs/nonneg"}, "record_count": {"$ref": "#/$defs/nonneg"}}},
    "relation_requirement": {"type": "object", "additionalProperties": false,
      "required": ["question", "from", "kind", "direction", "depth", "match", "endpoint_policy", "gold_derived_targets", "target_status"],
      "properties": {"question": {"type": "string"}, "from": {"$ref": "#/$defs/obsid"},
        "kind": {"enum": ["supports", "derived_from", "supersedes", "contradicts", "blocks", "depends_on", "part_of"]},
        "direction": {"const": "outgoing"}, "depth": {"const": 1}, "match": {"const": "all"},
        "endpoint_policy": {"enum": ["edge_witness", "all_current_targets_materialized"]},
        "gold_derived_targets": {"type": "array", "items": {"$ref": "#/$defs/obsid"}, "minItems": 1},
        "target_status": {"type": "array", "items": {"type": "string"}}}}
  }
}
